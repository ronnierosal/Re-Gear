.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
pyproject.toml text eol=lf
* text=auto
bin/** text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.map text eol=lf
*.md text eol=lf
# A handed-over patch is literal text: its context lines carry a leading space
# that the whitespace gate would otherwise read as trailing whitespace, and a
# CRLF checkout would refuse to apply to the *.py files that are pinned to LF.
*.patch text eol=lf whitespace=-trailing-space,-blank-at-eof
*.ts text eol=lf
*.tsx text eol=lf
*.svg text eol=lf
