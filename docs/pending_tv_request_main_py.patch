+    def _pending_tv_status(self) -> dict[str, object]:
+        """Categorical state for one explicit "take me to the TV" request.
+
+        The requested display identity stays behind this boundary, the way
+        the saved-TV status already keeps it off the payload. `requested`
+        says whether a request exists at all, so no state has to be
+        invented for the times one does not. `approval_offered` means the
+        existing preview/approve/execute path may be shown -- it is not an
+        approval, and the handheld keeps the session until the player
+        takes it.
+        """
+        status = self._pending_tv_state
+        pending = self._pending_tv
+        return {
+            "schema_version": 1,
+            "requested": bool(pending is not None and pending.outstanding),
+            "state": status.state.value if status is not None else "",
+            "code": status.code if status is not None else "",
+            "attempts": status.attempts if status is not None else 0,
+            "max_attempts": (
+                status.max_attempts if status is not None else DEFAULT_MAX_ATTEMPTS
+            ),
+            "approval_offered": bool(
+                status is not None and status.approval_offered
+            ),
+            "automatic_continuation": bool(
+                status is not None and status.automatic_continuation
+            ),
+            "blockers": list(status.blockers) if status is not None else [],
+        }
