+    async def request_tv_when_available(
+        self, _request: object = None
+    ) -> dict[str, object]:
+        """Record an explicit TV request while no ready output exists.
+
+        This records intent and nothing else. The handheld keeps the
+        session, no connector is forced, and no TV is asked to wake: when
+        the exact requested TV is detected the player approves the switch
+        through the path they already use. Refused outright without one
+        exact eGPU identity to bind to.
+        """
+        try:
