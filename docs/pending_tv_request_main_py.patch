+                SnapshotTransitionObservationAdapter(self._discovery).observe
+            )
+            profiles = resolve_runtime_profiles(current.snapshot)
+            pending = self._pending_tv_request()
+            status = await asyncio.to_thread(
+                lambda: pending.request(
+                    request_id=secrets.token_hex(8),
+                    source=RequestSource.MANUAL,
+                    attachment_binding=profiles.egpu_stable_id,
+                )
+            )
+        except Exception:
+            return {
+                "schema_version": 1,
+                "requested": False,
+                "state": "rejected",
+                "code": "pending_tv.service_unavailable",
+                "attempts": 0,
+                "max_attempts": DEFAULT_MAX_ATTEMPTS,
+                "approval_offered": False,
+                "automatic_continuation": False,
+                "blockers": [],
