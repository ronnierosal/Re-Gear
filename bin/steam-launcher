#!/usr/bin/python3
"""Re-Gear supervised Steam trial shim."""
from pathlib import Path
import sys
import os
import stat

def _unarmed_after_import_failure():
    # Deliberately independent of backend imports. Rollback fallback is allowed
    # only after authenticated absence of the persistent Steam arm.
    if sys.platform != 'linux':
        return False
    directory = None
    try:
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        directory = os.open('/', flags)
        for part in ('var', 'lib', 'regear', 'device-filter-arm'):
            info = os.fstat(directory)
            if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
                return False
            try:
                child = os.open(part, flags, dir_fd=directory)
            except FileNotFoundError:
                return True
            os.close(directory)
            directory = child
        info = os.fstat(directory)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            return False
        try:
            arm = os.open('steam-launcher.service.json',
                os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
        except FileNotFoundError:
            return True
        os.close(arm)
        return False
    except (OSError, ValueError):
        return False
    finally:
        if directory is not None:
            os.close(directory)


plugin_root = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(plugin_root / 'backend'))
try:
    from hdm.delivery.steam_trial_wrapper import main
except (ImportError, OSError, SyntaxError):
    if not _unarmed_after_import_failure():
        raise SystemExit(78)
    # Positively unarmed package rollback may use the native launcher.
    native = '/usr/lib/steamos/steam-launcher'
    os.execve(native, (native,), dict(os.environ))
    raise SystemExit(127)

raise SystemExit(main())
